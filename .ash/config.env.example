# Configuração local do ASH. Não vai para o git (.gitignore).
# O squad-lead preenche os nomes na primeira conversa (python ash.py configurar). O bootstrap preenche os buckets.
ASH_SQUAD=minha-squad
ASH_PO=
ASH_FDE=
ASH_DEV_REVISOR=
ASH_GIT_REMOTE=
ASH_GIT_NOME=
# ASH_GIT_EMAIL=
# AWS (só para o portão bootstrap). Preencha ASH_CONTA_ESPERADA com a conta AWS da squad; região padrão us-east-1.
ASH_CONTA_ESPERADA=
AWS_REGION=us-east-1
# AWS_PROFILE=
ASH_TAG_OWNER=
ASH_TAG_COST_CENTER=
ASH_TAG_ENV=dev
ASH_CODE_BUCKET=
ASH_EVENTS_BUCKET=
ASH_REPORTS_BUCKET=
# Protótipo da fase de descoberta (preenchidos pelo bootstrap; WAF CLOUDFRONT exige us-east-1).
ASH_PROTO_BUCKET=
ASH_PROTO_DISTRIBUTION=
# AWS Emulator (testes de integração locais; nada aqui toca conta AWS real). Regras: .kiro/steering/06-emulador-aws.md
# Modo do emulador: linux (pacote nativo), wsl (Windows, pacote dentro de uma distribuição WSL2) ou container. Padrão: vazio = detecção automática.
ASH_EMULADOR_MODO=
# Distribuição WSL2 que hospeda o emulador no modo wsl. Padrão: vazio = a primeira distribuição WSL2 própria encontrada.
ASH_EMULADOR_WSL_DISTRO=
# CLI de contêiner do modo container: docker ou podman. Padrão: vazio = o primeiro que responder.
ASH_CONTAINER_CLI=
# Porta HTTPS do emulador em 127.0.0.1. Padrão: 9297.
ASH_EMULADOR_PORTA=
# Segundos sem chamadas de API até o emulador se encerrar sozinho (--idle-timeout). Padrão: 1800.
ASH_EMULADOR_IDLE=
# sim = o ci e a etapa integracao-aws sobem o emulador e o param ao final (só se foram eles que subiram). Padrão: não (a etapa falha com mensagem clara).
ASH_EMULADOR_AUTO=
