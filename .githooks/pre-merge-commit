#!/usr/bin/env bash
# ASH: merge na main só pelo ash.py (portão merge), com ASH_MERGE=1.
branch="$(git branch --show-current 2>/dev/null)"
if [ "$branch" = "main" ] && [ "${ASH_MERGE:-0}" != "1" ]; then
  echo "ASH: merge na main só pelo portão merge do squad-lead (CI local + aprovações)." >&2
  exit 1
fi
exit 0
